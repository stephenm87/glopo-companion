# ============================================================
#  Glopo Companion — Environment Variables
#  Copy this to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore
# ============================================================

# --- AI APIs ---
GEMINI_API_KEY=your_gemini_key_here
SERPER_API_KEY=your_serper_key_here
GOOGLE_NL_API_KEY=your_google_cloud_nl_key_here
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Optional paid or self-hosted LanguageTool endpoint. The unsupported public
# endpoint is never called. When omitted, grammar checking uses Gemini.
LANGUAGETOOL_API_URL=
LANGUAGETOOL_API_KEY=

# --- Supabase (shared project) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side Supabase values used to validate function callers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# Optional comma-separated origins for previews or custom domains.
ALLOWED_ORIGINS=https://preview.example.org
